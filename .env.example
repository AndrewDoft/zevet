# Shared secret. Every teammate's hook and the hub must use the same value.
ZEVET_TOKEN=change-me-to-a-long-random-string

# Where the hub listens (hub side).
PORT=8787

# Where the hooks send events (client side). No trailing slash.
ZEVET_HUB=http://127.0.0.1:8787

# Your display name in the lanes. Defaults to your OS username.
ZEVET_ACTOR=andrew
