{
  "name": "zevet",
  "version": "0.2.101",
  "private": true,
  "type": "module",
  "description": "Watch your team's AI coding agents work, live, in one place.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "hub": "node hub/server.mjs",
    "install-hooks": "node client/install.mjs",
    "doctor": "node client/doctor.mjs",
    "test": "node scripts/run-tests.mjs",
    "ship": "node scripts/ship.mjs",
    "ipc:gen": "node desktop/node_modules/@masora/desktop-kit/bin/ipc-gen.js desktop/ipc-table.js --preload desktop/preload.js --dts board/src/lib/bridge.generated.d.ts",
    "ipc:check": "npm run ipc:gen -- --check",
    "typecheck": "npm --prefix board run typecheck"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@sentry/node": "10.75.0"
  }
}
