{
  "name": "zevet-desktop",
  "version": "0.2.54",
  "private": true,
  "description": "zevet — watch your team's coding agents",
  "main": "main.js",
  "author": "Andrew Doft",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --publish never",
    "dist:win": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --win --publish never",
    "dist:mac": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --mac --publish never",
    "smoke:mac": "node ../scripts/smoke-macos.mjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "electron": "38.1.2",
    "electron-builder": "25.1.8"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.0"
  },
  "build": {
    "afterPack": "./sign-macos.cjs",
    "appId": "com.andrewdoft.zevet",
    "productName": "zevet",
    "copyright": "Copyright © 2026 Andrew Doft",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "runtime.js",
      "preload.js",
      "local-fs.js",
      "agent-console.js",
      "console-log.js",
      "agent-worktree.js",
      "auto-title.js",
      "doc-sync.js",
      "repo-stats.js",
      "schedule.js",
      "file-watch.js",
      "status-sources.js",
      "ask-server.js",
      "computer.js",
      "zevet-mcp.js",
      "embedder.js",
      "index-capability.js",
      "code-index.js",
      "app-update.js",
      "zevet-voice.js",
      "agent-sessions.js",
      "agent-catalogs.js",
      "github-signin.js",
      "google-signin.js",
      "masora.js",
      "masora-connect.js",
      "masora-push.js",
      "chat.js",
      "chat-claude.js",
      "setup.html",
      "fonts/**",
      "build/icon.png",
      "!out/**",
      "!make-icon.mjs",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/!(${arch})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/{DirectML.dll,dxcompiler.dll,dxil.dll}"
    ],
    "extraResources": [
      {
        "from": "../client",
        "to": "client",
        "filter": [
          "*.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "zevet-${version}-windows-x64-setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zevet",
      "menuCategory": false,
      "uninstallDisplayName": "zevet",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "zevet-${version}-macos-arm64.${ext}",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Zevet",
      "background": "build/dmg-background.png",
      "iconSize": 104,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 180,
          "y": 232
        },
        {
          "x": 480,
          "y": 232,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
