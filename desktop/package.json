{
  "name": "zevet-desktop",
  "version": "0.2.137",
  "private": true,
  "description": "zevet — watch your team's coding agents",
  "main": "bootstrap.js",
  "author": "Andrew Doft",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --publish never",
    "dist:win": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --win --publish never",
    "dist:win-arm64": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --win --arm64 --publish never",
    "dist:linux": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --linux --x64 --publish never",
    "dist:mac": "node make-icon.mjs && node build.cjs -c electron-builder.config.js --mac --publish never",
    "smoke:mac": "node ../scripts/smoke-macos.mjs",
    "smoke:win": "node ../scripts/smoke-windows.mjs",
    "repro:fresh-silent": "node ../scripts/repro-fresh-silent-install.mjs"
  },
  "dependencies": {
    "@masora/desktop-kit": "github:AndrewDoft/desktop-kit#v0.2.3",
    "@sentry/electron": "7.20.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "electron": "44.4.5",
    "electron-builder": "26.17.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.0"
  },
  "payload": {
    "files": [
      "main.js",
      "payload-swap.js",
      "runtime.js",
      "preload.js",
      "local-fs.js",
      "agent-console.js",
      "zevet-router.js",
      "console-log.js",
      "board-ask.js",
      "console-persistence.js",
      "agent-worktree.js",
      "agent-integration.js",
      "auto-title.js",
      "doc-sync.js",
      "repo-stats.js",
      "schedule.js",
      "file-watch.js",
      "status-sources.js",
      "ask-server.js",
      "computer.js",
      "zevet-mcp.js",
      "permit-grants.js",
      "embedder.js",
      "overlap-check.js",
      "claims.js",
      "pinned-memory.js",
      "agent-tools.js",
      "data-frame.mjs",
      "step-claims.js",
      "payer.js",
      "index-capability.js",
      "code-index.js",
      "zevet-voice.js",
      "agent-sessions.js",
      "workspace-root.js",
      "api-root-lease.js",
      "agent-catalogs.js",
      "github-signin.js",
      "hub-target.js",
      "reconnect.js",
      "google-signin.js",
      "masora.js",
      "masora-link.js",
      "open-safe.js",
      "zevet-home.js",
      "ipc-guard.js",
      "ipc-table.js",
      "family.js",
      "reporting-health.js",
      "family-index.js",
      "sso.js",
      "idle-install.js",
      "masora-connect.js",
      "masora-push.js",
      "masora-runs.js",
      "credentials.js",
      "credential-ladder.js",
      "credential-usage.js",
      "agent-engine.js",
      "agent-api.js",
      "agent-steer.js",
      "agent-approval.js",
      "agent-spawn.js",
      "agent-takeover.js",
      "session-share.js",
      "chat.js",
      "chat-claude.js",
      "chat-cli.js",
      "chat-zevet.js",
      "repo-privacy.js",
      "sentry.js",
      "user-report.js",
      "setup.html",
      "fonts/**",
      "build/icon.png"
    ]
  },
  "build": {
    "afterPack": "./sign-macos.cjs",
    "afterSign": "./staple-macos.cjs",
    "afterAllArtifactBuild": "./notarize-dmg.cjs",
    "appId": "com.andrewdoft.zevet",
    "productName": "zevet",
    "copyright": "Copyright © 2026 Andrew Doft",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "bootstrap.js",
      "payload-config.js",
      "update-signing.js",
      "app-update.js",
      "update-rollback.js",
      "!out/**",
      "!make-icon.mjs",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/!(${arch})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/{DirectML.dll,dxcompiler.dll,dxil.dll}"
    ],
    "extraResources": [
      {
        "from": "app-core",
        "to": "app-core"
      },
      {
        "from": "../client",
        "to": "client",
        "filter": [
          "*.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "zevet-${version}-windows-${arch}-setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zevet",
      "menuCategory": false,
      "uninstallDisplayName": "zevet",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "zevet-${version}-macos-arm64.${ext}",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Zevet",
      "background": "build/dmg-background.png",
      "iconSize": 104,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 180,
          "y": 232
        },
        {
          "x": 480,
          "y": 232,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "zevet-${version}-linux-x64.${ext}",
      "icon": "build/icon.png"
    }
  }
}
