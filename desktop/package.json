{
  "name": "zevet-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "zevet \u2014 watch your team's coding agents",
  "main": "main.js",
  "author": "Andrew Doft",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.mjs",
    "dist": "node make-icon.mjs && electron-builder --publish never",
    "dist:win": "node make-icon.mjs && electron-builder --win --publish never",
    "dist:mac": "node make-icon.mjs && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "38.1.2",
    "electron-builder": "25.1.8"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.0"
  },
  "build": {
    "appId": "com.andrewdoft.zevet",
    "productName": "zevet",
    "copyright": "Copyright \u00a9 2026 Andrew Doft",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "local-fs.js",
      "agent-console.js",
      "doc-sync.js",
      "repo-stats.js",
      "file-watch.js",
      "status-sources.js",
      "embedder.js",
      "index-capability.js",
      "code-index.js",
      "setup.html",
      "fonts/**",
      "build/icon.png",
      "!out/**",
      "!make-icon.mjs",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/!(${arch})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*/{DirectML.dll,dxcompiler.dll,dxil.dll}"
    ],
    "extraResources": [
      {
        "from": "../client",
        "to": "client",
        "filter": [
          "*.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "zevet-${version}-windows-x64-setup.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "zevet",
      "menuCategory": false,
      "uninstallDisplayName": "zevet",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "zevet-${version}-macos-arm64.${ext}",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
